{
  "name": "discipline-whale",
  "version": "0.4.0",
  "description": "Discipline Whale for DeepSeek Harness: one main conversation routes work into workspaces, workers report back as pushed messages, and a turn-end check makes the report contract real.",
  "license": "MIT",
  "author": "huiyuanXP",
  "type": "module",
  "main": "home.js",
  "exports": {
    ".": "./home.js",
    "./main": "./main.js",
    "./worker": "./worker.js",
    "./home": "./home.js",
    "./store": "./store.js",
    "./registry": "./registry.js",
    "./guard": "./guard.js",
    "./adhd": "./adhd.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json",
    "./checkpoint": "./checkpoint.js",
    "./client": "./client.js",
    "./voice": "./voice.js",
    "./voice-silence": "./voice-silence.js",
    "./prompt-probe": "./prompt-probe.mjs",
    "./voice-settings": "./voice-settings.js"
  },
  "files": [
    "main.js",
    "worker.js",
    "home.js",
    "client.js",
    "voice.js",
    "voice-settings.js",
    "voice-silence.js",
    "store.js",
    "checkpoint.js",
    "registry.js",
    "guard.js",
    "adhd.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "VERIFICATION.md",
    "LICENSE",
    "prompt-probe.mjs",
    "test/*.mjs",
    "skills/**/*.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "discipline-whale",
    "multi-agent",
    "orchestration",
    "session"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huiyuanXP/discipline-whale.git"
  },
  "homepage": "https://github.com/huiyuanXP/discipline-whale#readme",
  "bugs": {
    "url": "https://github.com/huiyuanXP/discipline-whale/issues"
  },
  "engines": {
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "scripts": {
    "test": "node test/contract.mjs",
    "test:voice": "node test/voice.mjs",
    "test:client": "node test/client.mjs",
    "test:guard": "node test/guard.mjs",
    "test:all": "node test/contract.mjs && node test/guard.mjs && node test/adhd.mjs && node test/voice.mjs && node test/client.mjs && node test/dock.mjs && node test/settings.mjs",
    "test:smoke": "node test/smoke-restart.mjs",
    "test:dock": "node test/dock.mjs",
    "test:settings": "node test/settings.mjs",
    "test:adhd": "node test/adhd.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
